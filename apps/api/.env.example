# AEGIS API configuration
APP_NAME=AEGIS API
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:13000"]

# Local development infrastructure
DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis
REDIS_URL=redis://localhost:6379/0

# LLM provider credentials — leave blank until configured
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Jev decision engine credential — configure when available
JEV_API_KEY=
